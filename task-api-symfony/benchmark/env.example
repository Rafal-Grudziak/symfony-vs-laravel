# Optional hints for shell / project-root .env. The Task API stack is in docker-compose.yml
# (if a Flex `compose.yaml` exists, pass `-f docker-compose.yml` or set COMPOSE_FILE).

# Target API (host machine, Symfony default port):
#K6_BASE_URL=http://host.docker.internal:8081

# Inside Docker Compose network (nginx service, port 80 in-container):
#K6_BASE_URL=http://nginx

# Example one-liner (Linux/macOS):
# COMPOSE_PROFILES=benchmark docker compose -f docker-compose.yml run --rm --user "$(id -u):$(id -g)" k6 run /var/benchmark/k6/01-crud.js

# k6 load
#VUS=50
#DURATION=30s

# Seeded thesis dataset bounds (task/project id ranges)
#TASK_MAX_ID=10000
#PROJECT_MAX_ID=50

# Rows per bulk benchmark request (max 10000 per API validation)
#BULK_COUNT=50

# Enable the optional `benchmark` profile for every compose command (so `docker compose run --rm k6` works without --profile):
#COMPOSE_PROFILES=benchmark
